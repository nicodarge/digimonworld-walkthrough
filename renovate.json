{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["main"],
  "gitAuthor": "Nicolas Dargent <darge.nicolas@gmail.com>",
  "schedule": ["on monday, wednesday and friday"],
  "updateNotScheduled": false,
  "enabledManagers": ["custom.regex", "github-actions", "pip_requirements", "pre-commit"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "pre-commit pinned in a workflow, under a `# renovate:` comment",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+PRE_COMMIT_VERSION: (?<currentValue>\\S+)"
      ]
    }
  ]
}
